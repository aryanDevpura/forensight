# ForenSight Client Environment Template
# Set VITE_API_URL to the remote FastAPI Investigation Server endpoint.
# Leave blank to use local relative /api requests proxied via Vite dev server.
#
# Examples:
# Local Ubuntu server: VITE_API_URL=http://10.145.1.178:8000
# Local development:   VITE_API_URL=http://127.0.0.1:8000
VITE_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
