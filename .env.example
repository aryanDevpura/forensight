# ForenSight Server Configuration
FORENSIGHT_SERVER_HOST=127.0.0.1
FORENSIGHT_SERVER_PORT=8000
FORENSIGHT_ENV=development
FORENSIGHT_DEBUG=true

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./forensight.db

# Storage Directories (Relative to server directory or absolute)
EVIDENCE_STORAGE_PATH=./storage/evidence
REPORTS_STORAGE_PATH=./storage/reports

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ForenSight Collector Configuration
COLLECTOR_ID=collector-node-01
COLLECTOR_SERVER_HOST=127.0.0.1
COLLECTOR_SERVER_PORT=8000

# HMAC-SHA256 Pre-Shared Secret
# Used to authenticate collector → server evidence uploads.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FORENSIGHT_HMAC_SECRET=your-random-secret-here
